{
  "name": "snac-v2-backend",
  "version": "1.0.0",
  "description": "SNAC v2 Backend with enhanced security and performance",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint .",
    "security-audit": "npm audit --audit-level high",
    "gpu-check": "node utils/check_gpu.js",
    "build-cuda": "cd src/cuda && ./build_kernel.bat",
    "train": "python -m trainer.run",
    "docker-build": "docker compose build",
    "docker-up": "docker compose up -d"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.1.5",
    "validator": "^13.9.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "uuid": "^9.0.0",
    "prom-client": "^14.2.0",
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3",
    "ref-array-napi": "^1.2.1",
    "ws": "^8.13.0",
    "redis": "^4.6.12",
    "axios": "^1.6.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "nodemon": "^2.0.22",
    "eslint": "^8.39.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "snac",
    "backend",
    "ai",
    "security",
    "gpu",
    "cuda"
  ],
  "author": "SNAC Development Team",
  "license": "MIT"
}