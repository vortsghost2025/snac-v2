FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS base
WORKDIR /app

# Python + CUDA toolkit
RUN apt-get update && apt-get install -y python3-pip git gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Install PyTorch with CUDA support and other required packages
RUN pip install --no-cache-dir \
    torch==2.2.2+cu121 \
    transformers==4.41.2 \
    sentence-transformers==2.7.0 \
    accelerate==0.30.1 \
    peft==0.9.0 \
    datasets==2.19.1 \
    optuna==3.6.1 \
    mlflow==2.14.2 \
    redis==5.0.4 \
    numpy==1.24.3 \
    pandas==2.2.2

# Create trainer directory
RUN mkdir -p trainer

# Create data and models directories
RUN mkdir -p data models

# Copy trainer code
COPY src/agents/torch_llm.py trainer/
COPY src/agents/faiss_search.py trainer/

# Create the trainer module
RUN mkdir -p trainer
COPY --chown=appuser:appuser . .

# Create a basic trainer module
RUN echo "#!/usr/bin/env python3" > trainer/__init__.py && \
    echo '"""SNAC v2 GPU Trainer Module"""' >> trainer/__init__.py

# Create trainer runner
RUN echo '#!/usr/bin/env python3' > trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '"""' >> trainer/run.py && \
    echo 'GPU-Accelerated Training Module for SNAC v2' >> trainer/run.py && \
    echo 'Handles feedback collection, fine-tuning, and model registration' >> trainer/run.py && \
    echo '"""' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo 'import os, json, time, random' >> trainer/run.py && \
    echo 'import torch' >> trainer/run.py && \
    echo 'from datasets import Dataset' >> trainer/run.py && \
    echo 'from transformers import AutoModelForCausalLM, AutoTokenizer' >> trainer/run.py && \
    echo 'from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training' >> trainer/run.py && \
    echo 'from accelerate import Accelerator' >> trainer/run.py && \
    echo 'import mlflow' >> trainer/run.py && \
    echo 'import optuna' >> trainer/run.py && \
    echo 'import redis' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo '# 1️⃣  Load pending samples from Redis' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo 'r = redis.Redis.from_url(os.getenv(\"REDIS_URL\", \"redis://redis:6379\"))' >> trainer/run.py && \
    echo 'BATCH_SIZE = int(os.getenv(\"TRAIN_BATCH_SIZE\", 256))' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo 'def fetch_batch():' >> trainer/run.py && \
    echo '    raw = r.lpop(\"training:queue\")' >> trainer/run.py && \
    echo '    if raw is None:' >> trainer/run.py && \
    echo '        return None' >> trainer/run.py && \
    echo '    samples = [json.loads(raw)]' >> trainer/run.py && \
    echo '    while len(samples) < BATCH_SIZE:' >> trainer/run.py && \
    echo '        raw = r.lpop(\"training:queue\")' >> trainer/run.py && \
    echo '        if raw is None: break' >> trainer/run.py && \
    echo '        samples.append(json.loads(raw))' >> trainer/run.py && \
    echo '    return samples' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo '# 2️⃣  Build a Dataset from the batch' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo 'def make_dataset(samples):' >> trainer/run.py && \
    echo '    prompts = [s[\"prompt\"] for s in samples]' >> trainer/run.py && \
    echo '    responses = [s[\"response\"] for s in samples]' >> trainer/run.py && \
    echo '    # Simple concatenation – you can add EOS tokens, etc.' >> trainer/run.py && \
    echo '    texts = [p + r for p, r in zip(prompts, responses)]' >> trainer/run.py && \
    echo '    return Dataset.from_dict({\"text\": texts})' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo '# 3️⃣  Training loop (GPU-accelerated)' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo 'def train_one_step(model_name, dataset, accelerator):' >> trainer/run.py && \
    echo '    tokenizer = AutoTokenizer.from_pretrained(model_name)' >> trainer/run.py && \
    echo '    tokenizer.pad_token = tokenizer.eos_token' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    def tokenize(batch):' >> trainer/run.py && \
    echo '        return tokenizer(batch[\"text\"], truncation=True, padding=\"max_length\", max_length=512)' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    tokenized = dataset.map(tokenize, batched=True, remove_columns=[\"text\"])' >> trainer/run.py && \
    echo '    tokenized.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\"])' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    # LoRA config – tiny adapter (few hundred KB)' >> trainer/run.py && \
    echo '    lora_cfg = LoraConfig(' >> trainer/run.py && \
    echo '        r=8,' >> trainer/run.py && \
    echo '        lora_alpha=16,' >> trainer/run.py && \
    echo '        target_modules=[\"q_proj\", \"v_proj\", \"k_proj\", \"o_proj\"],' >> trainer/run.py && \
    echo '        lora_dropout=0.05,' >> trainer/run.py && \
    echo '        bias=\"none\",' >> trainer/run.py && \
    echo '    )' >> trainer/run.py && \
    echo '    model = AutoModelForCausalLM.from_pretrained(' >> trainer/run.py && \
    echo '        model_name,' >> trainer/run.py && \
    echo '        torch_dtype=torch.float16,' >> trainer/run.py && \
    echo '        device_map=\"auto\",' >> trainer/run.py && \
    echo '        load_in_8bit=True,' >> trainer/run.py && \
    echo '    )' >> trainer/run.py && \
    echo '    model = prepare_model_for_kbit_training(model)' >> trainer/run.py && \
    echo '    model = get_peft_model(model, lora_cfg)' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    optimizer = torch.optim.AdamW(model.parameters(), lr=5e-5)' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    model, optimizer, tokenized = accelerator.prepare(model, optimizer, tokenized)' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    model.train()' >> trainer/run.py && \
    echo '    for epoch in range(1):  # one epoch per batch is enough for LoRA' >> trainer/run.py && \
    echo '        for batch in tokenized:' >> trainer/run.py && \
    echo '            outputs = model(**batch, labels=batch[\"input_ids\"])' >> trainer/run.py && \
    echo '            loss = outputs.loss' >> trainer/run.py && \
    echo '            accelerator.backward(loss)' >> trainer/run.py && \
    echo '            optimizer.step()' >> trainer/run.py && \
    echo '            optimizer.zero_grad()' >> trainer/run.py && \
    echo '    return model' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo '# 4️⃣  Main entry point' >> trainer/run.py && \
    echo '# -----------------------------------------------------------------' >> trainer/run.py && \
    echo 'def main():' >> trainer/run.py && \
    echo '    accelerator = Accelerator()' >> trainer/run.py && \
    echo '    model_name = os.getenv(\"BASE_MODEL\", \"microsoft/DialoGPT-medium\")' >> trainer/run.py && \
    echo '    mlflow.set_tracking_uri(os.getenv(\"MLFLOW_URL\", \"http://mlflow:5000\"))' >> trainer/run.py && \
    echo '    mlflow.set_experiment(\"snac-fine-tune\")' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '    while True:' >> trainer/run.py && \
    echo '        batch = fetch_batch()' >> trainer/run.py && \
    echo '        if not batch:' >> trainer/run.py && \
    echo '            time.sleep(5)   # idle wait' >> trainer/run.py && \
    echo '            continue' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '        ds = make_dataset(batch)' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo '        with mlflow.start_run():' >> trainer/run.py && \
    echo '            model = train_one_step(model_name, ds, accelerator)' >> trainer/run.py && \
    echo '            # Save LoRA adapter only (tiny)' >> trainer/run.py && \
    echo '            adapter_path = f\"/app/models/{int(time.time())}\"' >> trainer/run.py && \
    echo '            model.save_pretrained(adapter_path)' >> trainer/run.py && \
    echo '            mlflow.log_artifacts(adapter_path, artifact_path=\"lora_adapter\")' >> trainer/run.py && \
    echo '            mlflow.log_params({\"batch_size\": len(batch), \"base_model\": model_name})' >> trainer/run.py && \
    echo '            mlflow.set_tag(\"stage\", \"candidate\")' >> trainer/run.py && \
    echo '            print(f\"✅ Saved new LoRA adapter to {adapter_path}\")' >> trainer/run.py && \
    echo '' >> trainer/run.py && \
    echo 'if __name__ == \"__main__\":' >> trainer/run.py && \
    echo '    main()'

EXPOSE 5000   # optional API for on-demand training
CMD ["python", "-m", "trainer.run"]