# ---------------------------------------------------------
# SNAC v2 Trainer Dockerfile (Python + CUDA + PyTorch)
# ---------------------------------------------------------
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS base
WORKDIR /app

# Python + build deps
RUN apt-get update && apt-get install -y python3-pip python3-dev git gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Python deps (with compatible versions)
RUN pip install --no-cache-dir \
    torch==2.2.2+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir \
    fastapi==0.135.1 \
    uvicorn==0.41.0 \
    pydantic==2.12.5 \
    transformers==4.41.2 \
    sentence-transformers==2.7.0 \
    accelerate==0.30.1 \
    peft==0.9.0 \
    datasets==2.19.1 \
    optuna==3.6.1 \
    mlflow==2.14.2 \
    redis==5.0.4 \
    numpy==1.24.3 \
    qdrant-client==1.17.0 \
    httpx==0.28.1 \
    openai==2.26.0 \
    python-dotenv==1.2.2

# Create directories
RUN mkdir -p trainer data models

# Copy entire project (needed for main.py and agent modules)
COPY requirements.txt .
COPY main.py .
COPY src/ ./src/

# Create trainer entrypoint
RUN printf '#!/usr/bin/env python3\n\
import os, sys\n\
sys.path.insert(0, "/app")\n\
\n\
# Import the trainer logic\n\
import redis\n\
import json\n\
import time\n\
import torch\n\
from datasets import Dataset\n\
from transformers import AutoModelForCausalLM, AutoTokenizer\n\
from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n\
from accelerate import Accelerator\n\
import mlflow\n\
\n\
r = redis.Redis.from_url(os.getenv("REDIS_URL", "redis://redis:6379"))\n\
BATCH_SIZE = int(os.getenv("TRAIN_BATCH_SIZE", "256"))\n\
\n\
def fetch_batch():\n\
    samples = []\n\
    while len(samples) < BATCH_SIZE:\n\
        raw = r.lpop("training:queue")\n\
        if raw is None: break\n\
        samples.append(json.loads(raw))\n\
    return samples if samples else None\n\
\n\
def make_dataset(samples):\n\
    texts = [s.get("prompt", "") + s.get("response", "") for s in samples]\n\
    return Dataset.from_dict({"text": texts})\n\
\n\
def train_one_step(model_name, dataset, accelerator):\n\
    tokenizer = AutoTokenizer.from_pretrained(model_name)\n\
    tokenizer.pad_token = tokenizer.eos_token\n\
\n\
    def tokenize(batch):\n\
        return tokenizer(batch["text"], truncation=True, padding="max_length", max_length=512)\n\
\n\
    tokenized = dataset.map(tokenize, batched=True, remove_columns=["text"])\n\
    tokenized.set_format(type="torch", columns=["input_ids", "attention_mask"])\n\
\n\
    lora_cfg = LoraConfig(r=8, lora_alpha=16, target_modules=["q_proj","v_proj","k_proj","o_proj"], lora_dropout=0.05, bias="none")\n\
    model = AutoModelForCausalLM.from_pretrained(model_name, torch_dtype=torch.float16, device_map="auto", load_in_8bit=True)\n\
    model = prepare_model_for_kbit_training(model)\n\
    model = get_peft_model(model, lora_cfg)\n\
\n\
    optimizer = torch.optim.AdamW(model.parameters(), lr=5e-5)\n\
    model, optimizer, tokenized = accelerator.prepare(model, optimizer, tokenized)\n\
\n\
    model.train()\n\
    for batch in tokenized:\n\
        outputs = model(**batch, labels=batch["input_ids"])\n\
        loss = outputs.loss\n\
        accelerator.backward(loss)\n\
        optimizer.step()\n\
        optimizer.zero_grad()\n\
    return model\n\
\n\
def main():\n\
    accelerator = Accelerator()\n\
    model_name = os.getenv("BASE_MODEL", "microsoft/DialoGPT-medium")\n\
    mlflow.set_tracking_uri(os.getenv("MLFLOW_TRACKING_URI", "http://mlflow:5000"))\n\
    mlflow.set_experiment("snac-fine-tune")\n\
\n\
    print(f"Trainer started. Model: {model_name}")\n\
    while True:\n\
        batch = fetch_batch()\n\
        if not batch:\n\
            time.sleep(5)\n\
            continue\n\
        ds = make_dataset(batch)\n\
        with mlflow.start_run():\n\
            model = train_one_step(model_name, ds, accelerator)\n\
            adapter_path = f"/app/models/{int(time.time())}"\n\
            model.save_pretrained(adapter_path)\n\
            mlflow.log_artifacts(adapter_path, artifact_path="lora_adapter")\n\
            print(f"Saved LoRA adapter to {adapter_path}")\n\
\n\
if __name__ == "__main__":\n\
    main()\n\
' > trainer/run.py

RUN printf '"""SNAC v2 GPU Trainer Module"""\n' > trainer/__init__.py

CMD ["python3", "trainer/run.py"]
