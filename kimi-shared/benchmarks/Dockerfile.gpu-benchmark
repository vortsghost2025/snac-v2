FROM nvidia/cuda:12.4.0-devel-ubuntu22.04

LABEL maintainer="MEV-Swarm Engineering <eng@mev-swarm.com>"
LABEL version="2.0"
LABEL description="GTX 5060 GPU Benchmark Suite with CUDA 12.4"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    git \
    curl \
    wget \
    vim \
    nano \
    htop \
    build-essential \
    cmake \
    g++ \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --no-cache-dir \
    pandas==2.2.0 \
    matplotlib==3.8.0 \
    plotly==5.18.0 \
    seaborn==0.13.0 \
    numpy==1.24.0 \
    scikit-learn==1.3.0 \
    jupyter==1.0.0 \
    notebook==7.0.0

# Set up working directory
WORKDIR /workspace

# Copy all benchmark files
COPY scripts/ /workspace/scripts/
COPY src/ /workspace/src/
COPY sweeps/ /workspace/sweeps/
COPY *.md /workspace/

# Make scripts executable
RUN chmod +x /workspace/scripts/*.sh

# Set environment variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PYTHONPATH=/workspace:$PYTHONPATH

# Create necessary directories
RUN mkdir -p /workspace/build /workspace/logs /workspace/results

# Default command
ENTRYPOINT ["/bin/bash", "/workspace/scripts/benchmark_full_run.sh"]
