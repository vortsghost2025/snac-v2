# ---------------------------------------------------------
# SNAC v2 GPU Dockerfile
# Multi-stage: build CUDA + Node, then minimal runtime
# ---------------------------------------------------------

# 1. Builder – compile CUDA kernels, install deps
FROM nvidia/cuda:12.1-devel-ubuntu22.04 AS builder
WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    build-essential git curl python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Node 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Copy source
COPY . .

# Compile custom CUDA kernel (with correct flags)
RUN mkdir -p build
RUN nvcc -O3 -arch=sm_86 --generate-code arch=compute_86,code=sm_86 \
    -shared -o build/libmetabolism.so src/cuda/metabolism.cu \
    || echo "CUDA kernel compilation failed, continuing..."

# 2. Runtime – minimal image, GPU runtime only
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS runtime
WORKDIR /app

# Install Node runtime
RUN apt-get update && apt-get install -y curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy deps from builder (avoids double npm ci)
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

COPY --from=builder /app/build/libmetabolism.so ./build/ 2>/dev/null || true
COPY --from=builder /app/src ./src
COPY --from=builder /app/server.js .
COPY --from=builder /app/terminal-echo-bridge.js .
COPY --from=builder /app/security-middleware.js .
COPY --from=builder /app/utils ./utils
COPY --from=builder /app/we ./we
COPY --from=builder /app/routes ./routes
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/config ./config
COPY --from=builder /app/benchmarks ./benchmarks
COPY --from=builder /app/kimi-shared ./kimi-shared
COPY --from=builder /app/.agents ./.agents
COPY --from=builder /app/monitoring ./monitoring

# Create memory directory for PCM Mesh
RUN mkdir -p /app/memory

EXPOSE 8000 3001
CMD ["node", "server.js"]
